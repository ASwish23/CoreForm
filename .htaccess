# ══════════════════════════════════════════════════════════════════════════
#  CoreForm — Apache configuration
#  1. Pretty URLs   2. Custom 404   3. Compression   4. Caching   5. Security
# ══════════════════════════════════════════════════════════════════════════

# ── 1. Pretty URLs: strip .html from the address bar ──────────────────────
RewriteEngine On

# ── 00. One canonical host: https://coreform.ro ──────────────────────────
#    http:// and www. used to answer 200 with the same pages, so search
#    engines saw up to four copies of the site. Send everything to the
#    https, non-www origin in ONE hop. Scoped to the coreform.ro hostnames
#    so any temporary/preview hostname on the hosting account is untouched.
RewriteCond %{HTTP_HOST} ^(www\.)?coreform\.ro$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://coreform.ro%{REQUEST_URI} [R=301,L,NE]

# ── 01. Trailing slash on a page URL (/prints/) -> /prints ───────────────
#    Without this, /prints/ fell through to rule 1c and returned a 500.
#    Real folders (e.g. /pdfs/) are left alone.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 0. Archived product catalogue ────────────────────────────────────────
#    produse / produs were taken offline (the code is kept locally, outside
#    the repo). Old copies may still sit on the server from earlier deploys,
#    so send visitors to /prints and hide the leftover assets.
RewriteRule ^produse(\.html)?/?$ /prints? [R=301,L]
RewriteRule ^produs(\.html)?/?$ /prints? [R=301,L]
RewriteRule ^(produs\.js|produse\.css)$ - [R=404,L]

# The AI material advisor (consultanta) was removed, but an old copy is
# still on the server and answered 200. Its topic (choosing a 3D-printing
# material) now lives in the materials section of /prints.
RewriteRule ^consultanta(\.html)?/?$ /prints? [R=301,L]
RewriteRule ^archive(/|$) - [F,L]

# Images moved into /img — keep old public URLs (social share previews,
# bookmarked favicons, structured data) working.
RewriteRule ^PozeMarketing/(favicon-32\.png|favicon-180\.png|og-default\.jpg)$ /img/$1 [R=301,L]
RewriteRule ^logogreen\.png$ /img/logo-green.png [R=301,L]

# Old admin pages were replaced by /login + /dashboard (Mini-CRM).
RewriteRule ^admin-login(\.html)?/?$ /login? [R=301,L]
RewriteRule ^admin-dashboard(\.html)?/?$ /dashboard? [R=301,L]

# 1a) index.html -> / (canonical root, not /index)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[?\ ] [NC]
RewriteRule ^ / [R=301,L]

# 1b) Any other direct request for foo.html -> /foo (301, keeps query strings,
#     so old bookmarks/search-engine links land on the clean URL instead of
#     creating duplicate-content copies).
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html[?\ ] [NC]
RewriteRule ^ /%1 [R=301,L]

# 1c) Internally serve foo.html when /foo is requested, without changing what
#     shows in the address bar. Only kicks in when /foo isn't itself a real
#     file or directory (so images, css, js, and folders like /pdfs/ are
#     untouched).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ── 2. Custom error page ──────────────────────────────────────────────────
ErrorDocument 404 /404.html

# Never let the 404 page itself 301-redirect into a loop.
<Files "404.html">
  Header set Cache-Control "no-cache, must-revalidate"
</Files>

# ── 3. Compression ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/ttf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ── 4. Browser caching ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  # HTML must stay fresh so content edits go live immediately.
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"

  # Stylesheets and scripts: 1 week (bump the ?v= query when you deploy).
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType text/javascript           "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"

  # Images and fonts change rarely.
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/pdf           "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # PWA: the service worker and manifest must always be revalidated so new
  # versions are picked up (overrides the 1-week .js rule above).
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── 5. Security headers ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self)"
  # HTTPS is confirmed on coreform.ro and www.coreform.ro, and rule 00 now
  # forces it. includeSubDomains is left off on purpose until every other
  # subdomain (mail., cpanel., …) is known to have a valid certificate.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
</IfModule>

# ── 6. Block access to internal files ─────────────────────────────────────
<FilesMatch "\.(csv|cer|md|log|bak|sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteRule ^supabase/ - [F,L]
</IfModule>

# ── 7. Correct MIME types & charset ───────────────────────────────────────
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType font/woff2                 .woff2
  AddType application/xml            .xml
</IfModule>
